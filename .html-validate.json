{
  "extends": ["html-validate:recommended"],
  "rules": {
    "require-sri": "off",
    "no-trailing-whitespace": "warn",
    "void-style": ["warn", { "style": "omit" }],
    "no-inline-style": "off",
    "attribute-boolean-style": "off",
    "no-unknown-elements": "warn"
  },
  "elements": ["html5"]
}
